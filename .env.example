# claude-proxy runtime config — copy to .env and fill in.

# Required. The Bearer token n8n (or any client) must send in
# Authorization: Bearer <PROXY_API_KEY>. Generate with `openssl rand -hex 32`.
PROXY_API_KEY=

# Default model to use when the request omits `model` (n8n may or may not set it).
DEFAULT_MODEL=claude-opus-5

# Upstream Anthropic request timeout. Streaming requests use their own
# longer ceiling and don't honour this.
REQUEST_TIMEOUT=300s

# Network. Default binds 8080 on all interfaces. Set BIND_ADDR=127.0.0.1
# if you front this with Caddy/nginx on the same host.
HOST_PORT=8080
BIND_ADDR=0.0.0.0

# Pin blueship to a specific revision for reproducible image builds. Leave it
# unset to take the Dockerfile default, which is kept on a revision known good.
#
# Do NOT resurrect an old pin without checking what it does to OAuth: anything
# at or before 3f07ab03 refreshes against console.anthropic.com, which stopped
# serving that endpoint on 2026-07-31. A build pinned there authenticates fine
# on first login and then drops auth every time the access token expires,
# roughly every 8 hours, which reads as "the proxy randomly logs itself out".
# BLUESHIP_REV=
